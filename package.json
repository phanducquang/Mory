{
  "name": "mory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "calendar:generate": "node scripts/generate-lunar-calendar.mjs",
    "calendar:check": "node scripts/generate-lunar-calendar.mjs --check",
    "postinstall": "prisma generate --config prisma.config.ts",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:validate": "prisma validate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "test:db": "node scripts/test-database.mjs",
    "test:account": "npm run build && node scripts/test-database.mjs --e2e",
    "media:maintain": "node --conditions=react-server --import tsx scripts/media-maintenance.ts",
    "storage:check": "node --conditions=react-server --import tsx scripts/check-storage.ts",
    "test:media": "npm run build && node scripts/test-database.mjs --media --e2e",
    "auth:mail": "node --conditions=react-server --import tsx scripts/auth-mail.ts",
    "test:email": "npm run build && node scripts/test-database.mjs --email --e2e",
    "reminders:schedule": "node --conditions=react-server --import tsx scripts/reminders.ts",
    "privacy:maintain": "node --conditions=react-server --import tsx scripts/privacy-maintenance.ts",
    "backup": "node --conditions=react-server --import tsx scripts/backup.ts",
    "test:deploy": "node --test tests/deployment/deploy.test.mjs",
    "test:deploy:build": "node --test tests/deployment/standalone.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@better-auth/prisma-adapter": "1.7.10",
    "@hookform/resolvers": "^5.9.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.10",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "nodemailer": "10.1.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "astronomia": "4.2.0",
    "date-chinese": "2.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
