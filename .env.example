# Optional LOCAL services. The demo itself runs without any environment variables.
# Copy to .env.local for Next.js. Docker Compose reads .env or explicit --env-file.
# Set your own local passwords; no production credentials belong in the repository.
POSTGRES_USER=mory
POSTGRES_DB=mory
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# PostgreSQL server adapter. Setting this does not switch the demo UI to server data.
# Used only by explicit migration commands and server-side client construction.
DATABASE_URL=

# Account mode is opt-in. Generate a unique secret (at least 32 random characters).
# BETTER_AUTH_URL must be the exact HTTPS origin, or HTTP localhost for development.
MORY_DATA_MODE=demo
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
AUTH_ALLOW_SIGNUP=false

# Private media supports RustFS or another compatible S3 service. See docs/rustfs.md.
# Requires account mode + a private bucket created by the operator.
# Never prefix secrets with NEXT_PUBLIC_. Worker: npm run media:maintain (loads .env).
MORY_MEDIA_ENABLED=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mory-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# RustFS: use the S3 API endpoint (usually :9000), not the Console (:9001).
# Production: S3_ENDPOINT=https://s3.example.com; keep S3_FORCE_PATH_STYLE=true.

# Verified email/recovery. Web enqueues encrypted jobs; SMTP credentials are worker-only.
AUTH_EMAIL_ENABLED=false
AUTH_MAIL_FROM=
AUTH_MAIL_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_ALLOW_INSECURE_LOCAL=false

# Saved-event reminders; each recipient must opt in through Settings.
MORY_REMINDERS_ENABLED=false

# Optional authenticated reverse-proxy IP forwarding (overwrite headers at the trusted edge).
# Keep app unreachable directly; see docs/security-operations.md. Unset = shared auth budget.
AUTH_TRUSTED_EDGE_SECRET=

# Operator backup key: a DIFFERENT random 32-byte base64 key, held outside the DB/mail key.
MORY_BACKUP_KEY=
# Optional absolute paths to matching PostgreSQL tools. Credentials stay in environment.
# PG_DUMP_BIN=/usr/bin/pg_dump
# PSQL_BIN=/usr/bin/psql
# For multiple replicas/rolling deployments: shared build/runtime action key (32-byte base64).
# Keep stable in secret manager; never NEXT_PUBLIC_. See bundled Next.js Server Actions guide.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# PM2 deployment only (see docs/run-and-deploy-pm2.md).
PORT=3000
# Server mode starts enabled workers by default. false = use an external scheduler instead.
MORY_PM2_WORKERS=true
